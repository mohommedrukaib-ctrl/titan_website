# ─────────────────────────────────────────────────────────────────────────────
#  TITAN EVENTS — environment settings
#  Copy this file to `.env` and adjust the values. Never commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Public site URL (used for canonical tags, sitemap and link previews)
SITE_URL=https://titanevents.lk

# ── Admin account ────────────────────────────────────────────────────────────
# Used only to create the admin user on the very first run (when data/titan.json
# does not exist yet). Change the password from Admin → Security afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Titan@2025

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED in production: a long random string. Sessions (and therefore logins)
# are invalidated whenever this value changes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Failed login lockout
ADMIN_MAX_ATTEMPTS=5
ADMIN_ATTEMPT_WINDOW=15
ADMIN_LOCK_MINUTES=15

# Per-IP rate limits (requests per hour)
RATE_LOGIN_HOUR=30
RATE_FORM_HOUR=12
RATE_BACKUP_HOUR=10

# ── Uploads & backups ────────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=12582912
BACKUP_KEEP=25

# ── SEO / analytics (all optional) ───────────────────────────────────────────
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── Storage paths (optional overrides) ───────────────────────────────────────
# DATA_DIR=./data
# UPLOAD_DIR=./public/uploads/events
