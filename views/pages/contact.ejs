<section class="page-hero">
  <div class="shell">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span>/</span> <span>Contact</span>
    </nav>
    <div class="page-head">
      <span class="eyebrow">Let's Plan Something Beautiful</span>
      <h1>Contact Us</h1>
      <p class="lead">
        Call, WhatsApp or send the form below with a few details about your event. A planner — not a
        call centre — will get back to you with ideas and indicative pricing.
      </p>
    </div>
  </div>
</section>

<section class="section section--tight">
  <div class="shell contact-grid">
    <!-- ------------------------- left: details ------------------------- -->
    <div class="reveal">
      <h2 style="font-size:1.5rem;margin-bottom:1.3rem">Our Details</h2>
      <div class="contact-list">
        <div class="contact-item">
          <div class="contact-item__icon"><%- icon('phone', 'ico', 19) %></div>
          <div>
            <div class="contact-item__label">Call us</div>
            <div class="contact-item__value">
              <a href="<%= fmt.telHref(settings.phonePrimary) %>"><%= settings.phonePrimary %></a>
            </div>
            <% if (settings.phoneSecondary) { %>
            <div class="contact-item__value">
              <a href="<%= fmt.telHref(settings.phoneSecondary) %>"><%= settings.phoneSecondary %></a>
            </div>
            <% } %>
            <% if (settings.whatsapp) { %>
            <small>WhatsApp: <a href="https://wa.me/<%= settings.whatsapp.replace(/\D/g, '') %>" target="_blank" rel="noopener noreferrer"><%= settings.whatsapp %></a></small>
            <% } %>
          </div>
        </div>

        <div class="contact-item">
          <div class="contact-item__icon"><%- icon('mail', 'ico', 19) %></div>
          <div>
            <div class="contact-item__label">Email</div>
            <div class="contact-item__value"><a href="mailto:<%= settings.email %>"><%= settings.email %></a></div>
            <small>Attach floor plans, mood boards or briefs — we read everything.</small>
          </div>
        </div>

        <div class="contact-item">
          <div class="contact-item__icon"><%- icon('pin', 'ico', 19) %></div>
          <div>
            <div class="contact-item__label">Studio</div>
            <div class="contact-item__value"><%= settings.address %></div>
            <small>Visits by appointment so a planner can give you their full attention.</small>
          </div>
        </div>

        <div class="contact-item">
          <div class="contact-item__icon"><%- icon('clock', 'ico', 19) %></div>
          <div>
            <div class="contact-item__label">Response time</div>
            <div class="contact-item__value"><%= settings.responseTime %></div>
            <small><%= settings.hours %></small>
          </div>
        </div>

        <div class="contact-item">
          <div class="contact-item__icon"><%- icon('sparkles', 'ico', 19) %></div>
          <div>
            <div class="contact-item__label">Follow us</div>
            <div class="socials" style="margin-top:.5rem">
              <% socials.forEach(function (s) { %>
              <a href="<%= s.url %>" target="_blank" rel="noopener noreferrer" aria-label="<%= s.name %>"><%= icon(s.key, 'ico', 18) %></a>
              <% }); %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- -------------------------- right: form -------------------------- -->
    <div class="reveal" data-delay="1" id="form">
      <div class="form-card">
        <h2 style="font-size:1.5rem">Send an Inquiry</h2>
        <p class="muted" style="margin:.6rem 0 1.5rem;font-size:.9rem">
          Fields marked <span class="gold">*</span> are required. We reply to every message personally.
        </p>

        <% if (locals.sent || (locals.query && locals.query.sent)) { %>
        <div class="alert alert--success" role="status">
          <%= icon('check', 'ico', 18) %>
          <div>
            <strong>Thank you — your inquiry has been received.</strong><br>
            A Titan Events planner will contact you within 24 hours. For urgent requests please call
            <a href="<%= fmt.telHref(settings.phonePrimary) %>" class="gold"><%= settings.phonePrimary %></a>.
          </div>
        </div>
        <% } %>

        <% if (locals.flashError) { %>
        <div class="alert alert--error" role="alert">
          <%= icon('close', 'ico', 18) %>
          <div><%= locals.flashError.message %></div>
        </div>
        <% } %>

        <form id="inquiryForm" action="/contact" method="post" data-track novalidate>
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="formOpenedAt" value="<%= Date.now() %>">
          <div class="hp" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" type="text" name="website" tabindex="-1" autocomplete="off">
          </div>

          <div class="grid-2">
            <div class="field <%= locals.errors && locals.errors.name ? 'has-error' : '' %>">
              <label for="name">Full Name <span class="req">*</span></label>
              <input class="input" id="name" name="name" type="text" required autocomplete="name"
                     value="<%= (locals.values && locals.values.name) || '' %>" placeholder="e.g. Nimal Perera">
              <% if (locals.errors && locals.errors.name) { %><span class="field__error"><%= locals.errors.name %></span><% } %>
            </div>

            <div class="field <%= locals.errors && locals.errors.email ? 'has-error' : '' %>">
              <label for="email">Email <span class="req">*</span></label>
              <input class="input" id="email" name="email" type="email" required autocomplete="email"
                     value="<%= (locals.values && locals.values.email) || '' %>" placeholder="you@example.com">
              <% if (locals.errors && locals.errors.email) { %><span class="field__error"><%= locals.errors.email %></span><% } %>
            </div>
          </div>

          <div class="grid-2">
            <div class="field <%= locals.errors && locals.errors.phone ? 'has-error' : '' %>">
              <label for="phone">Phone Number <span class="muted">(optional)</span></label>
              <input class="input" id="phone" name="phone" type="tel" autocomplete="tel"
                     value="<%= (locals.values && locals.values.phone) || '' %>" placeholder="+94 77 000 0000">
              <% if (locals.errors && locals.errors.phone) { %><span class="field__error"><%= locals.errors.phone %></span><% } %>
            </div>

            <div class="field">
              <label for="eventDate">Event Date <span class="muted">(optional)</span></label>
              <input class="input" id="eventDate" name="eventDate" type="date"
                     value="<%= (locals.values && locals.values.eventDate) || '' %>">
              <span class="field__hint">Rough dates are fine — we'll confirm availability.</span>
            </div>
          </div>

          <div class="field <%= locals.errors && locals.errors.eventType ? 'has-error' : '' %>">
            <label for="eventType">Event Type</label>
            <select class="select" id="eventType" name="eventType">
              <% const selectedType = (locals.values && locals.values.eventType) || 'wedding'; %>
              <% eventCategories.concat([{ key: 'other', label: 'Other' }]).forEach(function (c) { %>
              <option value="<%= c.key %>" <%= selectedType === c.key ? 'selected' : '' %>><%= c.label %></option>
              <% }); %>
              <option value="unsure" <%= selectedType === 'unsure' ? 'selected' : '' %>>Not sure yet</option>
            </select>
            <% if (locals.errors && locals.errors.eventType) { %><span class="field__error"><%= locals.errors.eventType %></span><% } %>
          </div>

          <div class="field <%= locals.errors && locals.errors.message ? 'has-error' : '' %>">
            <label for="message">Message <span class="req">*</span></label>
            <textarea class="textarea" id="message" name="message" required maxlength="4000"
                      placeholder="Tell us about your event — guest count, venue, services you need (planning, décor, sound &amp; lighting, ticketing, photography) and your budget range if you have one."><%= (locals.values && locals.values.message) || '' %></textarea>
            <% if (locals.errors && locals.errors.message) { %><span class="field__error"><%= locals.errors.message %></span><% } %>
          </div>

          <button class="btn btn--gold btn--lg btn--block" type="submit" data-submit>
            <%= icon('arrowRight', 'ico', 16) %> Send Inquiry
          </button>
          <p class="field__hint" style="margin-top:.9rem;text-align:center">
            Your details are used only to respond to this inquiry. We never share them.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<section class="section section--tight section--panel">
  <div class="shell">
    <div class="grid grid--3">
      <div class="reveal">
        <div class="why__icon" style="margin-bottom:.9rem"><%- icon('megaphone', 'ico', 20) %></div>
        <h3>Planning ahead?</h3>
        <p class="muted">Weddings and large concerts book 6–12 months out. Earlier means better venues and better pricing.</p>
      </div>
      <div class="reveal" data-delay="1">
        <div class="why__icon" style="margin-bottom:.9rem"><%- icon('ticket', 'ico', 20) %></div>
        <h3>Ticket support</h3>
        <p class="muted">Already bought tickets? Have your order reference ready and call us — gate and refund queries are handled by Titan Tickets.</p>
      </div>
      <div class="reveal" data-delay="2">
        <div class="why__icon" style="margin-bottom:.9rem"><%- icon('briefcase', 'ico', 20) %></div>
        <h3>Corporate RFP?</h3>
        <p class="muted">We respond to formal RFPs with a technical rider, stage plot and itemised quotation. Ask for our corporate deck.</p>
      </div>
    </div>
  </div>
</section>
