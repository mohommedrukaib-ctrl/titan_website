<div class="a-head">
  <div>
    <h2>Activity Log</h2>
    <p>Every sign-in, edit and deletion is recorded with a timestamp and IP address.</p>
  </div>
  <a class="btn btn--outline btn--sm" href="/admin/backup"><%- icon('backup', 'ico', 14) %> Backups</a>
</div>

<section class="a-card a-card--pad">
  <% if (activity.length) { %>
  <div class="table-wrap">
    <table class="a-table">
      <thead><tr><th>When</th><th>Action</th><th>Detail</th><th>Who</th><th>IP</th></tr></thead>
      <tbody>
        <% activity.forEach(function (a) { %>
        <tr>
          <td><%= fmt.formatDateTime(a.at) %><br><span class="muted" style="font-size:.76rem"><%= fmt.timeAgo(a.at) %></span></td>
          <td><span class="timeline__action"><%= a.action %></span></td>
          <td><%= a.detail || '—' %></td>
          <td><%= a.actor || 'admin' %></td>
          <td class="muted"><%= a.ip || '—' %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <div class="empty-state">
    <img src="/img/logo-mark.png" alt="" width="60" height="60" loading="lazy">
    <h3>No activity recorded yet</h3>
    <p>Sign-ins and content changes will be listed here.</p>
  </div>
  <% } %>
</section>
